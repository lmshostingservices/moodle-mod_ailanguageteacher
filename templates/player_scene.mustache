{{!
    @template mod_ailanguageteacher/player_scene

    One scene: the numbered phrase rail on the left, the picture with numbered pins and leader lines, and the tray of
    phrases to drag (Practice and Test).

    Example context (json):
    {
        "id": 3, "title": "The housekeeper arrives", "context": "It is 8 am.", "image": "", "ratio": 1.6,
        "width": 1600, "height": 1000, "n": 2, "compact": false, "study": true, "hastray": false, "lang": "en-AU",
        "pins": [{"token": "p1", "number": 1, "x": 30, "y": 40, "text": "Good morning!", "romanisation": "",
            "color": "#6366F1", "ink": "#4338CA"}],
        "chips": []
    }
}}
<section class="lt-slide{{#hastray}} has-tray{{/hastray}}" aria-roledescription="slide" data-scene="{{id}}">
    <div class="lt-board lt-n{{n}}{{#compact}} lt-compact{{/compact}}" style="--n: {{n}};">
        <div class="lt-rail" role="list">
            {{#pins}}
            <div class="lt-slot" role="listitem">
                <div class="lt-slot-zone" tabindex="0" role="button" data-pin="{{token}}">
                    <span class="lt-slot-num">{{number}}</span>
                    <div class="lt-slot-body">
                        {{#study}}
                        <div class="lt-chip lt-chip-static" style="--c: {{color}}; --ink: {{ink}};">
                            <span class="lt-chip-text" dir="auto" lang="{{lang}}">{{text}}</span>
                            {{#romanisation}}<span class="lt-chip-rom">{{.}}</span>{{/romanisation}}
                        </div>
                        {{/study}}
                    </div>
                </div>
            </div>
            {{/pins}}
        </div>
        <div class="lt-figure" style="--ar: {{width}} / {{height}}; --arn: {{ratio}};">
            <img class="lt-image" src="{{image}}" alt="{{title}}" draggable="false">
            {{#pins}}
            <button type="button" class="lt-pin" data-pin="{{token}}" tabindex="-1" style="left: {{x}}%; top: {{y}}%;">{{number}}</button>
            {{/pins}}
        </div>
        <svg class="lt-lines" aria-hidden="true" focusable="false"></svg>
    </div>
    {{#context}}<p class="lt-scenecontext" dir="auto">{{context}}</p>{{/context}}
    {{#hastray}}
    <div class="lt-tray" role="group" aria-label="{{#str}} labeltray, mod_ailanguageteacher {{/str}}">
        {{#chips}}
        <button type="button" class="lt-chip" data-token="{{token}}" aria-pressed="false" style="--c: {{color}}; --ink: {{ink}};">
            <span class="lt-chip-text" dir="auto" lang="{{lang}}">{{text}}</span>
            {{#romanisation}}<span class="lt-chip-rom">{{.}}</span>{{/romanisation}}
            <span class="lt-chip-meaning" hidden>{{translation}}</span>
        </button>
        {{/chips}}
        <div class="lt-tray-done">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
            <span>{{#str}} allplaced, mod_ailanguageteacher {{/str}}</span>
        </div>
    </div>
    {{/hastray}}
    <div class="lt-stagebar" data-region="stage" hidden></div>
</section>
