{{!
    @template mod_ailanguageteacher/scenes

    Set-up step 6 (pictures), 7 (voices) or 8 (check each scene), one card per scene in learning order.

    Example context (json):
    {
        "bar": {"current": 7, "total": 9, "steps": [{"number": 7, "name": "Voices", "done": false, "current": true, "dot": 0}]},
        "pictures": false, "voicesstep": true, "check": false, "hasscenes": true, "count": 1, "cmid": 1,
        "canvoice": true, "novoiceservice": false, "voiceaction": "#", "sesskey": "abc",
        "voicelist": [{"name": "en-AU-Chirp3-HD-Kore", "label": "Kore (female)", "selected": true}], "voice2list": [{"name": "en-AU-Chirp3-HD-Charon", "label": "Charon (male)", "selected": true}], "hasvoice2": true, "voicematch": true,
        "missingvoices": 1, "missingvoiceids": "4", "missingvoicecredits": 5, "voicecredits": 5,
        "groups": [{"name": "Greetings", "cards": [{"id": 1, "number": 1, "title": "At reception", "image": "",
            "noimage": true, "phrases": 1, "placed": 0, "placedok": false, "novoices": 1,
            "voices": [{"id": 4, "text": "Good morning", "hasvoice": false, "who": "Male voice"}],
            "editurl": "#", "replaceurl": "#", "deleteurl": "#", "upurl": null, "downurl": null}]}],
        "nav": {"backurl": "#", "backlabel": "Back", "nexturl": "#", "nextlabel": "Next: Check the scenes", "blocked": ""}
    }
}}
<div id="lt-scenes" class="lt-wizard lt-slides" data-cmid="{{cmid}}">
    <div class="lt-setup-head">
        <h2 class="h3">{{#str}} setup_title, mod_ailanguageteacher {{/str}}</h2>
        {{#bar}}{{> mod_ailanguageteacher/setup_steps}}{{/bar}}
    </div>

    {{#pictures}}
    <div class="lt-wstep">
        <h3 class="lt-wstep-title">{{#str}} pictures_title, mod_ailanguageteacher {{/str}}</h3>
        <p class="lt-mini mb-0">{{#str}} pictures_intro, mod_ailanguageteacher {{/str}}</p>
    </div>
    {{/pictures}}

    {{#voicesstep}}
    <div class="lt-wstep">
        <h3 class="lt-wstep-title">{{#str}} voices_title, mod_ailanguageteacher {{/str}}</h3>
        {{#canvoice}}
        <p class="lt-mini">{{#str}} voices_intro, mod_ailanguageteacher {{/str}}</p>
        <form method="post" action="{{voiceaction}}" class="lt-voicepick">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="action" value="voice">
            <label for="lt-voice"><strong>{{#str}} voices_choose, mod_ailanguageteacher {{/str}}</strong></label>
            <select id="lt-voice" name="voice" class="custom-select form-select" data-region="voice">
                {{#voicelist}}<option value="{{name}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/voicelist}}
            </select>
            {{#hasvoice2}}
            <label for="lt-voice2"><strong>{{#str}} voices_choose2, mod_ailanguageteacher {{/str}}</strong></label>
            <select id="lt-voice2" name="voice2" class="custom-select form-select">
                {{#voice2list}}<option value="{{name}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/voice2list}}
            </select>
            {{/hasvoice2}}
            <label class="lt-check-row lt-voicematch"><input type="checkbox" name="voicematch" value="1" {{#voicematch}}checked{{/voicematch}}><span>{{#str}} voices_match, mod_ailanguageteacher {{/str}}</span></label>
            <button type="submit" class="lt-btn lt-btn-ghost lt-btn-sm">{{#str}} voices_save, mod_ailanguageteacher {{/str}}</button>
        </form>
        <p class="lt-mini">{{#str}} voices_match_help, mod_ailanguageteacher {{/str}}</p>
        {{#missingvoices}}
        <button type="button" class="lt-btn lt-btn-primary mt-3" data-action="voiceall" data-phrases="{{missingvoiceids}}" data-credits="{{voicecredits}}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 5L6 9H2v6h4l5 4V5zM15.5 8.5a5 5 0 010 7M19 5a10 10 0 010 14"/></svg>
            <span>{{#str}} voices_createall, mod_ailanguageteacher, { "count": {{missingvoices}}, "credits": {{missingvoicecredits}} } {{/str}}</span>
        </button>
        {{/missingvoices}}
        {{^missingvoices}}<p class="lt-ok mb-0">{{#str}} voices_alldone, mod_ailanguageteacher {{/str}}</p>{{/missingvoices}}
        {{/canvoice}}
        {{#novoiceservice}}<p class="lt-note mb-0">{{#str}} voices_none, mod_ailanguageteacher {{/str}}</p>{{/novoiceservice}}
    </div>
    {{/voicesstep}}

    {{#check}}
    <div class="lt-wstep">
        <h3 class="lt-wstep-title">{{#str}} check_title, mod_ailanguageteacher {{/str}}</h3>
        <p class="lt-mini mb-0">{{#str}} check_intro, mod_ailanguageteacher {{/str}}</p>
    </div>
    {{/check}}

    {{^hasscenes}}<p class="lt-note">{{#str}} noscenesyet, mod_ailanguageteacher {{/str}}</p>{{/hasscenes}}
    {{#groups}}
    <h3 class="lt-group-title">{{name}}</h3>
    <div class="lt-slides-grid">
        {{#cards}}
        <div class="lt-slidecard" data-scene="{{id}}">
            <div class="lt-slidecard-thumb">
                {{#image}}<img src="{{image}}" alt="" loading="lazy">{{/image}}
                {{#noimage}}<span class="lt-slidecard-noimage">{{#str}} noimageyet, mod_ailanguageteacher {{/str}}</span>{{/noimage}}
                <span class="lt-slidecard-no">{{#str}} scenex, mod_ailanguageteacher, {{number}} {{/str}}</span>
            </div>
            <div class="lt-slidecard-body">
                <h4 class="lt-slidecard-title">{{title}}</h4>
                {{#pictures}}
                <div class="lt-slidecard-meta {{#noimage}}is-warn{{/noimage}}">{{#noimage}}{{#str}} sceneneedsimage, mod_ailanguageteacher {{/str}}{{/noimage}}{{^noimage}}{{#str}} scenehasimage, mod_ailanguageteacher {{/str}}{{/noimage}}</div>
                <a class="lt-btn {{#noimage}}lt-btn-primary{{/noimage}}{{^noimage}}lt-btn-ghost{{/noimage}} lt-btn-sm w-100" href="{{replaceurl}}">{{#noimage}}{{#str}} uploadownimage, mod_ailanguageteacher {{/str}}{{/noimage}}{{^noimage}}{{#str}} replaceownimage, mod_ailanguageteacher {{/str}}{{/noimage}}</a>
                {{/pictures}}
                {{#voicesstep}}
                <ul class="lt-voicelist">
                    {{#voices}}<li class="{{^hasvoice}}is-warn{{/hasvoice}}" data-phrase="{{id}}"><span>{{text}}</span> {{#who}}<span class="lt-voicewho">{{.}}</span> {{/who}}<span class="lt-mini">{{#hasvoice}}{{#str}} voice_ready, mod_ailanguageteacher {{/str}}{{/hasvoice}}{{^hasvoice}}{{#str}} voice_missing, mod_ailanguageteacher {{/str}}{{/hasvoice}}</span></li>{{/voices}}
                </ul>
                {{/voicesstep}}
                {{#check}}
                <div class="lt-slidecard-meta {{^placedok}}is-warn{{/placedok}}">
                    {{#str}} phrasesummary, mod_ailanguageteacher, { "phrases": {{phrases}}, "placed": {{placed}} } {{/str}}
                </div>
                <div class="lt-slidecard-actions">
                    <a class="lt-btn {{^placedok}}lt-btn-primary{{/placedok}}{{#placedok}}lt-btn-ghost{{/placedok}} lt-btn-sm" href="{{editurl}}">{{#str}} editphrases, mod_ailanguageteacher {{/str}}</a>
                    {{#upurl}}<a class="lt-iconbtn" href="{{upurl}}" title="{{#str}} moveleft, mod_ailanguageteacher {{/str}}" aria-label="{{#str}} moveleft, mod_ailanguageteacher {{/str}}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg></a>{{/upurl}}
                    {{#downurl}}<a class="lt-iconbtn" href="{{downurl}}" title="{{#str}} moveright, mod_ailanguageteacher {{/str}}" aria-label="{{#str}} moveright, mod_ailanguageteacher {{/str}}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg></a>{{/downurl}}
                    <a class="lt-iconbtn" href="{{deleteurl}}" title="{{#str}} delete {{/str}}" aria-label="{{#str}} delete {{/str}}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/></svg></a>
                </div>
                {{/check}}
            </div>
        </div>
        {{/cards}}
    </div>
    {{/groups}}

    {{> mod_ailanguageteacher/setup_nav}}
</div>
