{{!
    @template mod_ailanguageteacher/builder

    Set-up steps 1 to 4: language, situations, learners, level. Back and Next move between them.

    Example context (json):
    {
        "cmid": 1, "action": "#", "sesskey": "abc", "bar": {"current": 1, "total": 9, "steps": [{"number": 1, "name": "Language", "done": false, "current": true, "dot": 1}]}, "forcelang": false,
        "illustration": true, "photo": false,
        "languages": [{"code": "en", "name": "English", "endonym": "English", "showendonym": false, "selected": true,
            "multilocale": true, "locales": [{"locale": "en-AU", "name": "English (Australia)", "selected": true}]}],
        "supports": [{"code": "th", "name": "Thai", "endonym": "ไทย", "showendonym": true, "selected": true, "haspack": false}],
        "levels": [{"code": "A1", "name": "Beginner", "desc": "Very simple phrases", "ielts": "Below 3", "selected": true}],
        "groups": [{"key": "everyday", "name": "Everyday life", "items": [{"key": "greetings", "name": "Greetings", "checked": true}]}],
        "custom": [{"index": 1, "value": "", "hidden": false}],
        "scenesper": [{"value": 3, "selected": true}], "phrasesper": [{"value": 2, "selected": true}]
    }
}}
<form id="lt-wizard" class="lt-wizard" method="post" action="{{action}}">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <input type="hidden" name="savechoices" value="1">
    <div class="lt-setup-head">
        <h2 class="h3">{{#str}} setup_title, mod_ailanguageteacher {{/str}}</h2>
        {{#bar}}{{> mod_ailanguageteacher/setup_steps}}{{/bar}}
    </div>

    <fieldset class="lt-wstep" data-step="1">
        <legend class="lt-wstep-title">{{#str}} q_language, mod_ailanguageteacher {{/str}}</legend>
        <p class="lt-mini">{{#str}} q_language_help, mod_ailanguageteacher {{/str}}</p>
        <div class="lt-cardgrid">
            {{#languages}}
            <label class="lt-pick">
                <input type="radio" name="targetlang" value="{{code}}" {{#selected}}checked{{/selected}} required>
                <span class="lt-pick-body">
                    <strong>{{name}}</strong>
                    {{#showendonym}}<span class="lt-pick-endonym" lang="{{code}}" {{#rtl}}dir="rtl"{{/rtl}}>{{endonym}}</span>{{/showendonym}}
                </span>
            </label>
            {{/languages}}
        </div>
        {{#languages}}
        {{#multilocale}}
        <div class="lt-variety" data-variety="{{code}}">
            <p class="lt-variety-label">{{#str}} q_variety, mod_ailanguageteacher {{/str}}</p>
            <div class="lt-chiprow">
                {{#locales}}
                <label class="lt-pickchip"><input type="radio" name="targetlocale_{{code}}" value="{{locale}}" {{#selected}}checked{{/selected}}><span>{{name}}</span></label>
                {{/locales}}
            </div>
        </div>
        {{/multilocale}}
        {{^multilocale}}{{#locales}}<input type="hidden" name="targetlocale_{{code}}" value="{{locale}}">{{/locales}}{{/multilocale}}
        {{/languages}}
    </fieldset>

    <fieldset class="lt-wstep" data-step="2">
        <legend class="lt-wstep-title">{{#str}} q_situations, mod_ailanguageteacher {{/str}}</legend>
        <p class="lt-mini">{{#str}} q_situations_help, mod_ailanguageteacher {{/str}}</p>
        <div class="lt-sitgroups">
            {{#groups}}
            <div class="lt-sitgroup">
                <h3 class="lt-sitgroup-title">{{name}}</h3>
                {{#items}}
                <label class="lt-check-row lt-sit"><input type="checkbox" name="situations[]" value="{{key}}" {{#checked}}checked{{/checked}}><span>{{name}}</span></label>
                {{/items}}
            </div>
            {{/groups}}
        </div>
        <div class="lt-panel lt-custom">
            <h3 class="lt-sitgroup-title">{{#str}} q_custom, mod_ailanguageteacher {{/str}}</h3>
            <p class="lt-mini">{{#str}} q_custom_help, mod_ailanguageteacher {{/str}}</p>
            {{#custom}}
            <input type="text" class="lt-input" name="custom[]" value="{{value}}" maxlength="120" data-custom="{{index}}" aria-label="{{#str}} q_custom, mod_ailanguageteacher {{/str}} {{index}}" placeholder="{{#str}} q_custom_placeholder, mod_ailanguageteacher {{/str}}" {{#hidden}}hidden{{/hidden}}>
            {{/custom}}
            <button type="button" class="lt-btn lt-btn-ghost lt-btn-sm" data-action="addcustom">{{#str}} q_custom_add, mod_ailanguageteacher {{/str}}</button>
        </div>
        <div class="lt-sizes">
            <label>{{#str}} scenesper, mod_ailanguageteacher {{/str}}
                <select name="scenesper" class="custom-select form-select">{{#scenesper}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{value}}</option>{{/scenesper}}</select>
            </label>
            <label>{{#str}} phrasesper, mod_ailanguageteacher {{/str}}
                <select name="phrasesper" class="custom-select form-select">{{#phrasesper}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{value}}</option>{{/phrasesper}}</select>
            </label>
            <label>{{#str}} imagestyle, mod_ailanguageteacher {{/str}}
                <select name="imagestyle" class="custom-select form-select">
                    <option value="illustration" {{#illustration}}selected{{/illustration}}>{{#str}} imagestyle_illustration_name, mod_ailanguageteacher {{/str}}</option>
                    <option value="photo" {{#photo}}selected{{/photo}}>{{#str}} imagestyle_photo_name, mod_ailanguageteacher {{/str}}</option>
                </select>
            </label>
        </div>
        <p class="lt-wizard-error" data-region="siterror" hidden>{{#str}} q_situations_none, mod_ailanguageteacher {{/str}}</p>
    </fieldset>

    <fieldset class="lt-wstep" data-step="3">
        <legend class="lt-wstep-title">{{#str}} q_learners, mod_ailanguageteacher {{/str}}</legend>
        <p class="lt-mini">{{#str}} q_learners_help, mod_ailanguageteacher {{/str}}</p>
        <div class="lt-cardgrid">
            {{#supports}}
            <label class="lt-pick">
                <input type="radio" name="supportlang" value="{{code}}" data-haspack="{{#haspack}}1{{/haspack}}{{^haspack}}0{{/haspack}}" {{#selected}}checked{{/selected}} required>
                <span class="lt-pick-body">
                    <strong>{{name}}</strong>
                    {{#showendonym}}<span class="lt-pick-endonym" lang="{{code}}" {{#rtl}}dir="rtl"{{/rtl}}>{{endonym}}</span>{{/showendonym}}
                </span>
            </label>
            {{/supports}}
        </div>
        <label class="lt-check-row lt-forcelang" data-region="forcelang">
            <input type="checkbox" name="forcelang" value="1" {{#forcelang}}checked{{/forcelang}}>
            <span>{{#str}} forcelang, mod_ailanguageteacher {{/str}}</span>
        </label>
        <p class="lt-mini" data-region="nopack" hidden>{{#str}} forcelang_nopack, mod_ailanguageteacher {{/str}}</p>
    </fieldset>

    <fieldset class="lt-wstep" data-step="4">
        <legend class="lt-wstep-title">{{#str}} q_level, mod_ailanguageteacher {{/str}}</legend>
        <p class="lt-mini">{{#str}} q_level_help, mod_ailanguageteacher {{/str}}</p>
        <div class="lt-levels">
            {{#levels}}
            <label class="lt-pick lt-level">
                <input type="radio" name="cefrlevel" value="{{code}}" {{#selected}}checked{{/selected}} required>
                <span class="lt-pick-body">
                    <span class="lt-level-code">{{code}}</span>
                    <strong>{{name}}</strong>
                    <span class="lt-level-desc">{{desc}}</span>
                    <span class="lt-ielts" data-region="ielts">{{#str}} ieltsband, mod_ailanguageteacher, {{ielts}} {{/str}}</span>
                </span>
            </label>
            {{/levels}}
        </div>
    </fieldset>

    <div class="lt-wizard-actions">
        <button type="button" class="lt-btn lt-btn-ghost" data-action="prev">{{#str}} previous, mod_ailanguageteacher {{/str}}</button>
        <button type="button" class="lt-btn lt-btn-primary" data-action="nextstep">{{#str}} next, mod_ailanguageteacher {{/str}}</button>
        <button type="submit" class="lt-btn lt-btn-primary" data-action="save">{{#str}} builder_save, mod_ailanguageteacher {{/str}}</button>
    </div>
</form>
