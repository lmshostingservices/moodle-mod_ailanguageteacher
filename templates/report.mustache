{{!
    @template mod_ailanguageteacher/report

    Teacher reports: learners, phrases and attempts.

    Example context (json):
    {
        "tabs": [{"name": "Learners", "url": "#", "active": true}], "learners": true, "phrases": false, "attempts": false,
        "groupselector": "", "identityheaders": [{"name": "Email address"}], "hasrows": true, "paging": "", "downloads": "",
        "rows": [{"fullname": "Ana Silva", "profileurl": "#", "identity": [{"value": "ana@example.com"}], "studied": true,
            "mastered": 4, "total": 10, "masterpct": 40, "needs": 1, "avgscore": "82%", "speaktries": 20, "hints": 3,
            "testbest": "90%", "testattempts": 1, "lastseen": "1/10/26"}]
    }
}}
<div id="lt-report" class="lt-report">
    <nav class="lt-tabs" aria-label="{{#str}} reports, mod_ailanguageteacher {{/str}}">
        {{#tabs}}<a class="lt-tab{{#active}} is-active{{/active}}" href="{{url}}" {{#active}}aria-current="page"{{/active}}>{{name}}</a>{{/tabs}}
    </nav>
    {{{groupselector}}}

    {{#learners}}
    <p class="lt-mini">{{#str}} report_learners_help, mod_ailanguageteacher {{/str}}</p>
    {{#hasrows}}
    <div class="table-responsive" tabindex="0" role="region" aria-label="{{#str}} report_learners, mod_ailanguageteacher {{/str}}">
    <table class="table table-sm lt-table">
        <thead><tr>
            <th scope="col">{{#str}} fullname {{/str}}</th>
            {{#identityheaders}}<th scope="col">{{name}}</th>{{/identityheaders}}
            <th scope="col">{{#str}} col_studied, mod_ailanguageteacher {{/str}}</th>
            <th scope="col">{{#str}} col_mastered, mod_ailanguageteacher {{/str}}</th>
            <th scope="col">{{#str}} col_needs, mod_ailanguageteacher {{/str}}</th>
            <th scope="col">{{#str}} col_avgscore, mod_ailanguageteacher {{/str}}</th>
            <th scope="col">{{#str}} col_speaktries, mod_ailanguageteacher {{/str}}</th>
            <th scope="col">{{#str}} col_hints, mod_ailanguageteacher {{/str}}</th>
            <th scope="col">{{#str}} col_testbest, mod_ailanguageteacher {{/str}}</th>
            <th scope="col">{{#str}} col_lastseen, mod_ailanguageteacher {{/str}}</th>
        </tr></thead>
        <tbody>
        {{#rows}}
        <tr>
            <td><a href="{{profileurl}}">{{fullname}}</a></td>
            {{#identity}}<td>{{value}}</td>{{/identity}}
            <td>{{#studied}}<span class="lt-yes">{{#str}} yes {{/str}}</span>{{/studied}}{{^studied}}<span class="lt-no">{{#str}} no {{/str}}</span>{{/studied}}</td>
            <td><span class="lt-meter" role="img" aria-label="{{mastered}} / {{total}}"><span class="lt-bar"><span style="width: {{masterpct}}%"></span></span>{{mastered}}/{{total}}</span></td>
            <td>{{needs}}</td>
            <td>{{avgscore}}</td>
            <td>{{speaktries}}</td>
            <td>{{hints}}</td>
            <td>{{testbest}}</td>
            <td>{{lastseen}}</td>
        </tr>
        {{/rows}}
        </tbody>
    </table>
    </div>
    {{{paging}}}
    {{{downloads}}}
    {{/hasrows}}
    {{^hasrows}}<p class="lt-note">{{#str}} nolearners, mod_ailanguageteacher {{/str}}</p>{{/hasrows}}
    {{/learners}}

    {{#phrases}}
    <p class="lt-mini">{{#str}} report_phrases_help, mod_ailanguageteacher {{/str}}</p>
    {{#hasrows}}
    <div class="table-responsive" tabindex="0" role="region" aria-label="{{#str}} report_phrases, mod_ailanguageteacher {{/str}}">
    <table class="table table-sm lt-table">
        <thead><tr>
            <th scope="col">{{#str}} col_scene, mod_ailanguageteacher {{/str}}</th>
            <th scope="col">#</th>
            <th scope="col">{{#str}} phrase, mod_ailanguageteacher {{/str}}</th>
            <th scope="col">{{#str}} col_learners, mod_ailanguageteacher {{/str}}</th>
            <th scope="col">{{#str}} col_mastered, mod_ailanguageteacher {{/str}}</th>
            <th scope="col">{{#str}} col_needs, mod_ailanguageteacher {{/str}}</th>
            <th scope="col">{{#str}} col_matchtries, mod_ailanguageteacher {{/str}}</th>
            <th scope="col">{{#str}} col_hints, mod_ailanguageteacher {{/str}}</th>
            <th scope="col">{{#str}} col_bestscore, mod_ailanguageteacher {{/str}}</th>
            <th scope="col">{{#str}} col_speaktriesavg, mod_ailanguageteacher {{/str}}</th>
            <th scope="col">{{#str}} col_testmatch, mod_ailanguageteacher {{/str}}</th>
            <th scope="col">{{#str}} col_testlisten, mod_ailanguageteacher {{/str}}</th>
            <th scope="col">{{#str}} col_testspeak, mod_ailanguageteacher {{/str}}</th>
        </tr></thead>
        <tbody>
        {{#rows}}
        <tr class="{{#hard}}lt-hardrow{{/hard}}">
            <td>{{scene}}</td><td>{{number}}</td><td dir="auto">{{text}}</td><td>{{learners}}</td><td>{{mastered}}</td>
            <td>{{needs}}</td><td>{{matchtries}}</td><td>{{hints}}</td><td>{{bestscore}}</td><td>{{speaktries}}</td>
            <td>{{testmatch}}</td><td>{{testlisten}}</td><td>{{testspeak}}</td>
        </tr>
        {{/rows}}
        </tbody>
    </table>
    </div>
    {{/hasrows}}
    {{^hasrows}}<p class="lt-note">{{#str}} nophrasesyet, mod_ailanguageteacher {{/str}}</p>{{/hasrows}}
    {{/phrases}}

    {{#attempts}}
    <nav class="lt-tabs lt-tabs-sub" aria-label="{{#str}} col_kind, mod_ailanguageteacher {{/str}}">
        {{#kinds}}<a class="lt-tab{{#active}} is-active{{/active}}" href="{{url}}" {{#active}}aria-current="page"{{/active}}>{{name}}</a>{{/kinds}}
    </nav>
    {{#hasrows}}
    <form method="post" action="{{actionurl}}" data-region="attemptsform">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <div class="table-responsive" tabindex="0" role="region" aria-label="{{#str}} report_attempts, mod_ailanguageteacher {{/str}}">
        <table class="table table-sm lt-table">
            <thead><tr>
                {{#canmanage}}<th scope="col"><input type="checkbox" data-action="selectall" aria-label="{{#str}} selectall {{/str}}"></th>{{/canmanage}}
                <th scope="col">{{#str}} fullname {{/str}}</th>
                {{#identityheaders}}<th scope="col">{{name}}</th>{{/identityheaders}}
                <th scope="col">{{#str}} col_attempt, mod_ailanguageteacher {{/str}}</th>
                <th scope="col">{{#str}} col_state, mod_ailanguageteacher {{/str}}</th>
                <th scope="col">{{#str}} col_started, mod_ailanguageteacher {{/str}}</th>
                <th scope="col">{{#str}} col_duration, mod_ailanguageteacher {{/str}}</th>
                <th scope="col">{{#str}} col_score, mod_ailanguageteacher {{/str}}</th>
                <th scope="col">{{#str}} percentage, grades {{/str}}</th>
            </tr></thead>
            <tbody>
            {{#rows}}
            <tr>
                {{#canmanage}}<td><input type="checkbox" name="attemptids[]" value="{{id}}" aria-label="{{#str}} select {{/str}} {{fullname}}"></td>{{/canmanage}}
                <td>{{fullname}}</td>
                {{#identity}}<td>{{value}}</td>{{/identity}}
                <td>{{attempt}}</td><td>{{state}}</td><td>{{started}}</td><td>{{duration}}</td><td>{{score}}</td><td>{{grade}}</td>
            </tr>
            {{/rows}}
            </tbody>
        </table>
        </div>
        {{#canmanage}}
        <div class="d-flex gap-2 flex-wrap">
            <button type="submit" class="btn btn-danger" name="action" value="delete" data-action="deleteselected">{{#str}} deleteselected, mod_ailanguageteacher {{/str}}</button>
            <button type="submit" class="btn btn-secondary" name="action" value="regrade">{{#str}} regradeall, mod_ailanguageteacher {{/str}}</button>
        </div>
        {{/canmanage}}
    </form>
    {{{paging}}}
    {{{downloads}}}
    {{/hasrows}}
    {{^hasrows}}<p class="lt-note">{{#str}} noattempts, mod_ailanguageteacher {{/str}}</p>{{/hasrows}}
    {{/attempts}}
</div>
