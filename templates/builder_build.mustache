{{!
    @template mod_ailanguageteacher/builder_build

    Lesson builder step 5: draft the scenes with AI (or with any AI assistant), review, and create them.

    Example context (json):
    {
        "cmid": 1, "backurl": "#", "scenesurl": "#", "canai": false, "hasbalance": false, "balance": "",
        "prompt": "Create a lesson", "existing": 0,
        "summary": {"target": "English (Australia)", "support": "Thai", "level": "A1 · Beginner",
            "situations": "Greetings, Farewells", "options": "2 scenes each, 5 phrases per scene"}
    }
}}
<div id="lt-build" class="lt-wizard lt-build" data-cmid="{{cmid}}" data-scenesurl="{{scenesurl}}">
    <div class="lt-wizard-head">
        <h2 class="h3">{{#str}} buildlesson, mod_ailanguageteacher {{/str}}</h2>
        <a class="lt-btn lt-btn-ghost lt-btn-sm" href="{{backurl}}">{{#str}} builder_change, mod_ailanguageteacher {{/str}}</a>
    </div>
    <dl class="lt-choices">
        <div><dt>{{#str}} step_language, mod_ailanguageteacher {{/str}}</dt><dd>{{summary.target}}</dd></div>
        <div><dt>{{#str}} step_learners, mod_ailanguageteacher {{/str}}</dt><dd>{{summary.support}}</dd></div>
        <div><dt>{{#str}} step_level, mod_ailanguageteacher {{/str}}</dt><dd>{{summary.level}}</dd></div>
        <div><dt>{{#str}} step_situations, mod_ailanguageteacher {{/str}}</dt><dd>{{summary.situations}}</dd></div>
        <div><dt>{{#str}} builder_size, mod_ailanguageteacher {{/str}}</dt><dd>{{summary.options}}</dd></div>
    </dl>
    {{#existing}}<p class="lt-note">{{#str}} builder_existing, mod_ailanguageteacher, {{existing}} {{/str}}</p>{{/existing}}

    <div class="lt-buildpaths">
        <div class="lt-panel lt-buildpath {{^canai}}is-off{{/canai}}">
            <h4><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/></svg>{{#str}} build_ai_title, mod_ailanguageteacher {{/str}}</h4>
            {{#canai}}
            <p class="lt-mini">{{#str}} build_ai_help, mod_ailanguageteacher {{/str}}</p>
            {{#hasbalance}}<p class="lt-mini">{{balance}}</p>{{/hasbalance}}
            <button type="button" class="lt-btn lt-btn-primary w-100" data-action="generate">{{#str}} build_ai_go, mod_ailanguageteacher {{/str}}</button>
            <p class="lt-mini">{{#str}} drafttariff, mod_ailanguageteacher {{/str}}</p>
            {{/canai}}
            {{^canai}}
            <p class="lt-mini">{{#str}} build_ai_off, mod_ailanguageteacher {{/str}}</p>
            {{#hasbalance}}<p class="lt-mini">{{balance}}</p>{{/hasbalance}}
            {{/canai}}
        </div>
        <div class="lt-panel lt-buildpath">
            <h4><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V6a2 2 0 00-2-2H6a2 2 0 00-2 2v8a2 2 0 002 2h2"/></svg>{{#str}} build_manual_title, mod_ailanguageteacher {{/str}}</h4>
            <ol class="lt-aihelper-steps">
                <li>{{#str}} build_manual_1, mod_ailanguageteacher {{/str}}</li>
                <li>{{#str}} build_manual_2, mod_ailanguageteacher {{/str}}</li>
                <li>{{#str}} build_manual_3, mod_ailanguageteacher {{/str}}</li>
            </ol>
            <button type="button" class="lt-btn lt-btn-ghost lt-btn-sm lt-copy" data-target="#lt-lessonprompt" data-done="{{#str}} copied, mod_ailanguageteacher {{/str}}">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V6a2 2 0 00-2-2H6a2 2 0 00-2 2v8a2 2 0 002 2h2"/></svg>
                <span>{{#str}} copyprompt, mod_ailanguageteacher {{/str}}</span>
            </button>
            <textarea id="lt-lessonprompt" class="lt-textarea lt-prompt-text" readonly rows="6" aria-label="{{#str}} build_manual_title, mod_ailanguageteacher {{/str}}">{{prompt}}</textarea>
            <label class="lt-mini d-block mt-2" for="lt-lessonjson">{{#str}} build_paste, mod_ailanguageteacher {{/str}}</label>
            <textarea id="lt-lessonjson" class="lt-textarea" rows="6" data-region="json" placeholder='{"scenes": [ ... ]}'></textarea>
            <button type="button" class="lt-btn lt-btn-primary mt-2" data-action="preview">{{#str}} build_preview, mod_ailanguageteacher {{/str}}</button>
        </div>
    </div>
    <div class="lt-review-draft" data-region="review" hidden></div>
</div>
