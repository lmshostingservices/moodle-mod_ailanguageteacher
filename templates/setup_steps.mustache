{{!
    @template mod_ailanguageteacher/setup_steps

    The set-up step bar. It shows progress only; teachers move with Back and Next.

    Example context (json):
    {
        "current": 6, "total": 9,
        "steps": [
            {"number": 5, "name": "Create the scenes", "done": true, "current": false, "dot": 0},
            {"number": 6, "name": "Pictures", "done": false, "current": true, "dot": 0},
            {"number": 7, "name": "Check the scenes", "done": false, "current": false, "dot": 0}
        ]
    }
}}
<p class="lt-mini lt-setup-progress" data-region="setupprogress">{{#str}} setup_progress, mod_ailanguageteacher, { "current": {{current}}, "total": {{total}} } {{/str}}</p>
<ol class="lt-wizard-steps lt-setupbar" aria-label="{{#str}} setup_title, mod_ailanguageteacher {{/str}}">
    {{#steps}}
    <li class="{{#done}}is-done{{/done}}{{#current}}is-active{{/current}}" {{#dot}}data-stepdot="{{dot}}"{{/dot}} {{#current}}aria-current="step"{{/current}}><span aria-hidden="true">{{number}}</span>{{name}}</li>
    {{/steps}}
</ol>
