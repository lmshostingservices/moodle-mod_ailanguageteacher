{{!
    @template mod_ailanguageteacher/player_shell

    Player frame: top bar, the scene slideshow and the action bar. Scenes are added by JavaScript.

    Example context (json):
    {"mode": "practice", "modetag": "Practice", "showstats": true}
}}
<div class="lt-shell lt-mode-{{mode}}" tabindex="-1">
    <div class="lt-topbar">
        <button type="button" class="lt-iconbtn lt-exit" data-action="exit" aria-label="{{#str}} exit, mod_ailanguageteacher {{/str}}" title="{{#str}} exit, mod_ailanguageteacher {{/str}}">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <div class="lt-titlewrap">
            <span class="lt-modetag lt-modetag-{{mode}}" data-region="modetag">{{modetag}}</span>
            <div class="lt-slidetitle">
                <span class="lt-situation" data-region="situation"></span>
                <span class="lt-slidename" data-region="title"></span>
                <span class="lt-counter"><span data-region="counter"></span><span class="lt-dots" data-region="dots" role="tablist"></span></span>
            </div>
        </div>
        <div class="lt-hint" data-region="hint"></div>
        <div class="lt-tools">
            {{#showstats}}
            <div class="lt-timer" data-region="timer" role="timer">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><span>0:00</span>
            </div>
            <div class="lt-score" data-region="score"></div>
            {{/showstats}}
            <button type="button" class="lt-iconbtn" data-action="mute"></button>
            <button type="button" class="lt-iconbtn" data-action="fullscreen"></button>
        </div>
    </div>
    <div class="lt-viewport" data-region="viewport"><div class="lt-track" data-region="track"></div></div>
    <div class="lt-actions" data-region="actions"></div>
</div>
