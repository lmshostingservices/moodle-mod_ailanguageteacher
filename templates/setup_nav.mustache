{{!
    @template mod_ailanguageteacher/setup_nav

    Back and Next at the bottom of a set-up step. Next can be held back with a reason.

    Example context (json):
    {
        "nav": {"backurl": "#", "backlabel": "Back", "nexturl": "#", "nextlabel": "Next: pictures", "blocked": ""}
    }
}}
{{#nav}}
<div class="lt-setupnav">
    {{#backurl}}<a class="lt-btn lt-btn-ghost" href="{{backurl}}">{{backlabel}}</a>{{/backurl}}
    <span class="lt-grow"></span>
    {{#blocked}}<p class="lt-setupnav-blocked" id="lt-setupnav-blocked">{{blocked}}</p>{{/blocked}}
    {{#nexturl}}
    {{^blocked}}<a class="lt-btn lt-btn-primary" href="{{nexturl}}" data-action="setupnext">{{nextlabel}}</a>{{/blocked}}
    {{#blocked}}<button type="button" class="lt-btn lt-btn-primary" disabled aria-describedby="lt-setupnav-blocked">{{nextlabel}}</button>{{/blocked}}
    {{/nexturl}}
</div>
{{/nav}}
