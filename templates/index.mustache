{{!
    @template mod_ailanguageteacher/index

    Activities in a course.

    Example context (json):
    {"rows": [{"name": "Greetings", "url": "#", "dimmed": false, "language": "English (Australia)", "level": "A1", "intro": ""}]}
}}
<table class="generaltable">
    <thead><tr>
        <th scope="col">{{#str}} name {{/str}}</th>
        <th scope="col">{{#str}} targetlang, mod_ailanguageteacher {{/str}}</th>
        <th scope="col">{{#str}} cefrlevel, mod_ailanguageteacher {{/str}}</th>
        <th scope="col">{{#str}} description {{/str}}</th>
    </tr></thead>
    <tbody>
    {{#rows}}
    <tr>
        <td><a href="{{url}}" {{#dimmed}}class="dimmed"{{/dimmed}}>{{name}}</a></td>
        <td>{{language}}</td>
        <td>{{level}}</td>
        <td>{{{intro}}}</td>
    </tr>
    {{/rows}}
    </tbody>
</table>
